{
  "name": "@mcp-write-safety/kit",
  "version": "0.1.0",
  "description": "Small helpers for MCP write tools: version checks, idempotency keys, strict inputs, truthful results, unknown outcomes and explicit annotations, for the MCP Write-Safety Requirements (MWS 0.9).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mws",
    "write-safety",
    "idempotency",
    "optimistic-concurrency",
    "agents"
  ],
  "homepage": "https://isokron.ai/mws",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isokron-ai/mcp-write-safety-kits.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/isokron-ai/mcp-write-safety-kits/issues"
  },
  "author": "IsoKron (Stormhaven Enterprises LLC) (https://isokron.ai)",
  "contributors": [
    "Joshua Bryan"
  ],
  "license": "Apache-2.0 AND CC-BY-4.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "schema",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

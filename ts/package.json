{
  "name": "@mcp-write-safety/kit",
  "version": "0.1.0",
  "private": true,
  "description": "Small helpers for MCP write tools: version checks, idempotency keys, strict inputs, truthful results, unknown outcomes and explicit annotations, for the MCP Write-Safety Requirements (MWS 0.9).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/test/*.test.js'",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
